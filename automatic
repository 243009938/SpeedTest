async function initConfig(env) {
    domain = formatDomain(env.DOMAIN || domain);
    token = env.TOKEN || token;  
    botToken = env.TG_TOKEN || botToken;  
    chatId = env.TG_ID || chatId; 
    jcType = env.JC_TYPE || jcType; 
    
    if (env.USERNAME && env.PASSWORD) {
        if (!accounts.some(a => a.username === env.USERNAME)) {
            accounts.push({ username: env.USERNAME, password: env.PASSWORD });
        }
    }
    for (let i = 1; i <= 20; i++) {
        const u = env[`USER_${i}`], p = env[`PASS_${i}`];
        if (u && p && !accounts.some(a => a.username === u)) {
            accounts.push({ username: u, password: p });
        }
    }
}
