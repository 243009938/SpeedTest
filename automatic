function decodeBase64Utf8(b64) {
    const binary = atob(b64);
    const bytes = Uint8Array.from(binary, c => c.charCodeAt(0));
    return new TextDecoder("utf-8").decode(bytes);
}

function getRandomUA() {
    const chromeVer = Math.floor(Math.random() * 15) + 115; 
    return `Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/${chromeVer}.0.0.0 Safari/537.36`;
}

function getRandomIP() {
    return `11${Math.floor(Math.random() * 8)}.${Math.floor(Math.random() * 255)}.${Math.floor(Math.random() * 255)}.${Math.floor(Math.random() * 255)}`;
}

// 核心逻辑：加入梯次错峰与自动重试机制
async function handleCheckIn() {
    try {
        validateConfig();
        
        const checkInPromises = accounts.map(async (acc, index) => {
            // 优化：梯次错峰发车 (每个账号基础间隔2秒，外加随机抖动，极大降低并发被拦概率)
            const baseDelay = index * 2000; 
            const randomJitter = Math.floor(Math.random() * 2000); 
            await new Promise(resolve => setTimeout(resolve, baseDelay + randomJitter));

            let lastErrorMsg = "";
            
            // 优化：加入重试机制，最多尝试 3 次
            for (let attempt = 1; attempt <= 3; attempt++) {
                // 每次重试都换一个全新的虚拟设备和 IP
                const virtualUA = getRandomUA();
                const virtualIP = getRandomIP();

                try {
                    if (jcType === "hongxingdl") {
                        return await hongxingdlCheckIn(acc.username, acc.password, virtualUA, virtualIP);
                    } else {
                        const cookies = await loginAndGetCookies(acc.username, acc.password, virtualUA, virtualIP);
                        return await performCheckIn(cookies, acc.username, acc.password, virtualUA, virtualIP);
                    }
                } catch (error) {
                    lastErrorMsg = error.message;
                    
                    // 如果是 403 拦截、502 崩溃等网络偶发错误，且还没达到上限，则重试
                    if (attempt < 3 && (lastErrorMsg.includes("403") || lastErrorMsg.includes("502") || lastErrorMsg.includes("拦截"))) {
                        await new Promise(resolve => setTimeout(resolve, 3000)); // 等待3秒后重试
                        continue;
                    } else {
                        // 如果是密码错误，或已经重试了3次依然失败，则停止尝试
                        break;
                    }
                }
            }

            // 格式化输出失败结果
            const retryInfo = lastErrorMsg.includes("403") ? " (已自动重试3次)" : "";
            return `地址: ${domain}\n账号: ${acc.username}\n密码: <tg-spoiler>${acc.password}</tg-spoiler>\n签到结果: ❌ 失败 (${lastErrorMsg}${retryInfo})`;
        });

        const allResults = await Promise.all(checkInPromises);
        checkInResult = allResults.join("\n\n------------------------\n\n");
    } catch (fatalError) {
        checkInResult = `致命配置错误: ${fatalError.message}`;
    }

    await sendMessage(checkInResult);
    return new Response(checkInResult, { status: 200 });
}

function validateConfig() {
    if (!domain || !accounts || accounts.length === 0) throw new Error("缺少域名或账号配置");
}

async function loginAndGetCookies(user, pass, ua, ip) {
    const loginUrl = `${domain}/auth/login`;
    const response = await fetch(loginUrl, {
        method: "POST",
        headers: { 
            "Content-Type": "application/json", 
            "User-Agent": ua, 
            "Accept": "application/json, text/plain, */*", 
            "Origin": domain, 
            "Referer": `${domain}/auth/login`,
            "X-Forwarded-For": ip,
            "X-Real-IP": ip,
            "Connection": "close"
        },
        body: JSON.stringify({ email: user, passwd: pass, remember_me: "on", code: "" }),  
    });

    const text = await response.text();
    if (!response.ok) throw new Error(`登录异常: HTTP ${response.status}`);

    let res;
    try { res = JSON.parse(text); } 
    catch (e) { throw new Error(`登录被防火墙拦截，未返回JSON`); }

    if (res.ret !== 1) throw new Error(res.msg || "登录失败: 账号或密码错误");

    let cookies = "";
    if (typeof response.headers.getSetCookie === 'function') {
        cookies = response.headers.getSetCookie().map(c => c.split(';')[0].trim()).join("; ");
    } else {
        const rawCookie = response.headers.get("set-cookie");
        if (!rawCookie) throw new Error("登录成功，但未获取到Cookie");
        const safeCookie = rawCookie.replace(/,\s*\d{2}-[a-zA-Z]{3}-\d{4}/g, "");
        cookies = safeCookie.split(',').map(c => c.split(';')[0].trim()).join("; ");
    }
    
    if (!cookies) throw new Error("Cookie解析为空");
    return cookies;
}

async function performCheckIn(cookies, user, pass, ua, ip) {
    const checkInUrl = `${domain}/user/checkin`;
    const response = await fetch(checkInUrl, {
        method: "POST",
        headers: {
            'Content-Type': 'application/json',
            'User-Agent': ua,
            'Accept': 'application/json, text/javascript, */*; q=0.01',
            'Origin': domain,
            'Referer': `${domain}/user/panel`,
            'Cookie': cookies,
            'X-Requested-With': 'XMLHttpRequest',
            'X-Forwarded-For': ip,
            'X-Real-IP': ip,
            'Connection': "close"
        },
        body: JSON.stringify({}), 
        redirect: "manual"
    });

    if (response.status === 302 || response.status === 301) {
        throw new Error("被踢回登录页(机场严格限制了单IP多账号)");
    }

    const text = await response.text();
    if (!response.ok) throw new Error(`签到请求异常 (HTTP ${response.status})`);

    let res;
    try { 
        res = JSON.parse(text); 
    } catch (e) { 
        if (text.includes("<!DOCTYPE html>")) throw new Error("服务器返回了网页而不是签到结果");
        throw new Error("签到接口被防火墙拦截");
    }

    if (res.ret !== 1 && res.ret !== 0) {
        throw new Error(res.msg || "未知签到错误");
    }

    return `地址: ${domain}\n账号: ${user}\n密码: <tg-spoiler>${pass}</tg-spoiler>\n签到结果: ${res.msg || "完成"}`;
}

